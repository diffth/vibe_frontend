      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { Github, Contact2, HelpCircle } from \'lucide-react\';\n\nexport default function Footer() {\n  return (\n    <footer className=\"bg-toss-gray-900 text-toss-gray-400 py-16 border-t border-toss-gray-800\">\n      <div className=\"max-w-6xl mx-auto px-6 space-y-12\">\n        {/* Footer Brand & Legal list */}\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8\">\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-6 h-6 rounded-full bg-toss-blue flex items-center justify-center\">\n                <div className=\"w-3 h-3 rounded-full border border-white bg-transparent\" />\n              </div>\n              <span className=\"font-display font-extrabold text-white tracking-tight text-lg\">\n                toss\n              </span>\n            </div>\n            <p className=\"text-xs text-toss-gray-500 max-w-xs leading-relaxed\">\n              \355\206\240\354\212\244\353\212\224 \354\213\234\354\244\221 \354\235\200\355\226\211\352\263\274\354\235\230 \354\240\225\353\263\264 \354\227\260\352\263\204\353\245\274 \355\206\265\355\225\264 \353\252\250\353\223\240 \354\247\200\354\227\275\354\240\201\354\235\270 \352\270\210\354\234\265 \355\224\204\353\241\234\354\204\270\354\212\244\353\245\274 \353\252\250\353\260\224\354\235\274 \355\204\260\354\271\230 \355\225\234 \353\262\210\354\234\274\353\241\234 \355\206\265\355\225\251 \352\264\200\353\246\254\355\225\230\353\212\224 \354\204\234\353\271\204\354\212\244 \355\224\214\353\236\253\355\217\274\354\236\205\353\213\210\353\213\244.\n            </p>\n          </div>\n\n          <div>\n            <h4 className=\"text-sm font-bold text-toss-gray-200 mb-3\">\355\232\214\354\202\254 \354\206\214\352\260\234</h4>\n            <ul className=\"space-y-2 text-xs text-toss-gray-400\">\n              <li><span className=\"hover:text-white cursor-pointer transition-colors\">\352\263\265\353\217\231\354\262\264 \354\206\214\352\260\234</span></li>\n              <li><span className=\"hover:text-white cursor-pointer transition-colors\">\354\261\204\354\232\251 \354\240\225\353\263\264</span></li>\n              <li><span className=\"hover:text-white cursor-pointer transition-colors\">\353\211\264\354\212\244\353\243\270 / \353\270\224\353\241\234\352\267\270</span></li>\n              <li><span className=\"hover:text-white cursor-pointer transition-colors\">\353\270\214\353\236\234\353\223\234 \352\260\200\354\235\264\353\223\234</span></li>\n            </ul>\n          </div>\n\n          <div>\n            <h4 className=\"text-sm font-bold text-toss-gray-200 mb-3\">\352\263\240\352\260\235\354\247\200\354\233\220</h4>\n            <ul className=\"space-y-2 text-xs text-toss-gray-400\">\n              <li><span className=\"hover:text-white cursor-pointer transition-colors\">\354\236\220\354\243\274 \353\254\273\353\212\224 \354\247\210\353\254\270</span></li>\n              <li><span className=\"hover:text-white cursor-pointer transition-colors\">\355\206\240\354\212\244 \354\225\210\354\213\254\353\263\264\354\203\201\354\240\234</span></li>\n              <li><span className=\"hover:text-white cursor-pointer transition-colors\">\352\270\210\353\246\254\354\235\270\355\225\230\354\232\224\352\265\254\352\266\214</span></li>\n              <li><span className=\"hover:text-white cursor-pointer transition-colors\">\353\257\274\354\233\220\354\240\221\354\210\230 \354\225\210\353\202\264</span></li>\n            </ul>\n          </div>\n\n          <div>\n            <h4 className=\"text-sm font-bold text-toss-gray-200 mb-3\">\352\263\240\352\260\235\354\204\274\355\204\260 \354\225\210\353\202\264</h4>\n            <ul className=\"space-y-2 text-xs text-toss-gray-400\">\n              <li><span className=\"text-white font-extrabold\">\354\240\204\355\231\224: 1599-4905</span></li>\n              <li><span>\354\235\264\353\251\224\354\235\274: support@toss.im</span></li>\n              <li><span>(24\354\213\234\352\260\204 365\354\235\274 \354\203\201\354\213\234 \354\232\264\354\230\201 \353\217\204\354\233\200\353\260\251)</span></li>\n            </ul>\n          </div>\n        </div>\n\n        {/* Corporate specifications and legal smallprint */}\n        <div className=\"pt-8 border-t border-toss-gray-800 space-y-4\">\n          <div className=\"flex flex-wrap gap-x-6 gap-y-2 text-xs text-toss-gray-400\">\n            <span className=\"text-white hover:underline cursor-pointer font-extrabold\">\352\260\234\354\235\270\354\240\225\353\263\264 \354\262\230\353\246\254\353\260\251\354\271\250</span>\n            <span className=\"hover:text-white cursor-pointer transition-colors\">\354\204\234\353\271\204\354\212\244 \354\235\264\354\232\251\354\225\275\352\264\200</span>\n            <span className=\"hover:text-white cursor-pointer transition-colors\">\354\212\244\353\247\210\355\212\270\355\217\260 \352\264\200\353\246\254 \352\260\200\354\235\264\353\223\234</span>\n            <span className=\"hover:text-white cursor-pointer transition-colors\">\354\234\204\354\271\230\352\270\260\353\260\230\354\204\234\353\271\204\354\212\244 \354\235\264\354\232\251\354\225\275\352\264\200</span>\n          </div>\n\n          <div className=\"text-[10px] text-toss-gray-600 space-y-1.5 leading-relaxed\">\n            <p>\n              (\354\243\274)\353\271\204\353\260\224\353\246\254\355\215\274\353\270\224\353\246\254\354\271\264 | \353\214\200\355\221\234: \354\235\264\354\212\271\352\261\264 | \354\202\254\354\227\205\354\236\220\353\223\261\353\241\235\353\262\210\355\230\270: 120-88-182500 | \355\206\265\354\213\240\355\214\220\353\247\244\354\227\205\354\213\240\352\263\240: \354\240\234 2026-\354\204\234\354\232\270\352\260\225\353\202\250-0318\355\230\270\n            </p>\n            <p>\n              \354\204\234\354\232\270\355\212\271\353\263\204\354\213\234 \352\260\225\353\202\250\352\265\254 \355\205\214\355\227\244\353\236\200\353\241\234 142, \354\225\204\355\201\254\355\224\214\353\240\210\354\235\264\354\212\244 12\354\270\265 | \352\263\240\352\260\235\354\204\274\355\204\260: 1599-4905 (\355\217\211\354\203\235 \353\254\264\353\243\214, 24\354\213\234\352\260\204 \354\227\260\354\244\221\353\254\264\355\234\264)\n            </p>\n            <p>\n              \355\230\270\354\212\244\355\214\205 \354\204\234\353\271\204\354\212\244 \354\240\234\352\263\265\354\236\220: (\354\243\274)\353\271\204\353\260\224\353\246\254\355\215\274\353\270\224\353\246\254\354\271\264 | Copyright &copy; Viva Republica, Inc. All rights reserved.\n            </p>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n}\n"
