        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "export default function CreditScoreSimulator() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [habits, setHabits] = useState<CreditHabit[]>(INITIAL_HABITS);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [baseScore, setBaseScore] = useState(720); // Base credit score"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
