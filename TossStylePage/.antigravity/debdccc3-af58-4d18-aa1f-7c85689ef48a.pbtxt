        lines {
          text: "  { id: \'h1\', title: \'\352\261\264\352\260\225\353\263\264\355\227\230\352\263\265\353\213\250 \353\202\251\353\266\200\352\263\265\354\213\234 \354\240\234\354\266\234\', scoreChange: 15, description: \'\354\265\234\352\267\274 6\352\260\234\354\233\224\352\260\204 \354\227\260\354\262\264 \354\227\206\354\235\264 \353\202\251\353\266\200\355\225\234 \354\213\244\354\240\201\354\235\204 \354\246\235\353\252\205\355\225\251\353\213\210\353\213\244.\', checked: false, category: \'\352\263\265\352\263\265\352\270\260\353\241\235\' },"
