        }
        lines {
          text: "    setHabits(prev =>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      prev.map(h => h.id === id ? { ...h, checked: !h.checked } : h)"
