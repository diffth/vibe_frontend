          text: "  { id: \'h4\', title: \'\352\276\270\354\244\200\355\225\234 \354\262\264\355\201\254\354\271\264\353\223\234 \354\235\264\354\232\251\354\246\235\353\252\205\', scoreChange: 22, description: \'\354\243\274\352\261\260\353\236\230 \354\235\200\355\226\211 \354\262\264\355\201\254\354\271\264\353\223\234 \354\240\225\352\270\260 \354\206\214\353\271\204 \352\262\260\354\240\234\354\235\264\353\240\245\354\235\204 \352\260\200\354\202\260\355\225\251\353\213\210\353\213\244.\', checked: false, category: \'\354\206\214\353\271\204\354\212\265\352\264\200\' },"
